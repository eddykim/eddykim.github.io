# Bundler cache
.bundle
vendor
Gemfile.lock

# Jekyll cache
.jekyll-cache
.jekyll-metadata
_site

# RubyGems
*.gem

# NPM dependencies
node_modules
package-lock.json

# IDE configurations
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# Misc
_sass/vendors
assets/js/dist

# Hidden system files
*~
.DS_Store
Thumbs.db

# Python (_code/ 시뮬레이션 스크립트)
__pycache__/
*.pyc
.venv/

# Obsidian 편집기 설정 (워크플로와 무관)
.obsidian/

# 개인 문서 (사이트에 공개 게시되지 않도록 제외)
*.pdf
!assets/files/**/*.pdf

# 참고자료 보관소 — 내용물은 커밋하지 않고 README 만 추적한다
_references/*
!_references/README.md

# 로컬 미리보기 빌드
_site_dev
